# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_USER=chatmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatmanager

# Panel (web)
# Domain of the panel (DNS A record -> server); Caddy issues the HTTPS certificate for it
PANEL_DOMAIN=panel.example.com
BASE_URL=https://panel.example.com
# Only for docker-compose.dev.yml (direct access to the panel without Caddy)
WEB_PORT=3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=

# Bot token and API ID/HASH are set in the panel (Настройки), stored encrypted with AUTH_SECRET.
TIMEZONE_NAME=Europe/Moscow
# Public URL of the panel, for the "template saved" link in the bot reply (no link if empty)
PANEL_URL=
