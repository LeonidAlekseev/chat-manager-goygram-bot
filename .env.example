# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_USER=chatmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatmanager

# Panel (web)
BASE_URL=http://localhost:3000
WEB_PORT=3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=

# Bot token and API ID/HASH are set in the panel (Настройки), stored encrypted with AUTH_SECRET.
TIMEZONE_NAME=Europe/Moscow
# Public URL of the panel, for the "template saved" link in the bot reply (no link if empty)
PANEL_URL=
