// The panel owns the DB schema; the bot reads/writes these tables via raw SQL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  manager
}

model Manager {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  name         String   @default("")
  passwordHash String   @map("password_hash")
  role         Role     @default(manager)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  // Telegram link: the bot sets telegramUserId when the manager sends it /start link_<linkCode>.
  telegramUserId    BigInt?   @unique @map("telegram_user_id")
  linkCode          String?   @unique @map("link_code")
  linkCodeExpiresAt DateTime? @map("link_code_expires_at") @db.Timestamptz(3)
  templates         Template[]
  schedules         Schedule[]
  sends             Outbox[]
  chats             ChatManager[]

  @@map("managers")
}

model Chat {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique @map("telegram_id")
  title      String
  active     Boolean   @default(true)
  // Set by the panel's «Удалить»: the bot leaves the group and deletes the row (journal by cascade).
  deleting   Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  scheduleId Int?      @map("schedule_id") // a chat follows at most one schedule
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  sendLogs   SendLog[]
  outbox     Outbox[]
  managers   ChatManager[] // who may see and work with the chat; the superadmin sees all
  photo      ChatPhoto?
  // when the bot last looked at the group's photo (#113); NULL = due (a new chat, a photo change)
  photoCheckedAt DateTime? @map("photo_checked_at") @db.Timestamptz(3)

  @@map("chats")
}

// The group's small (160×160) photo, downloaded by the bot; no row = no photo, the panel shows a letter.
model ChatPhoto {
  chatId    Int      @id @map("chat_id")
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  uniqueId  String   @map("unique_id") // Telegram's file_unique_id: a new one means a new photo
  mime      String
  data      Bytes
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("chat_photos")
}

// Assigned by the superadmin; a manager sees only the chats assigned to them.
model ChatManager {
  chatId    Int     @map("chat_id")
  managerId Int     @map("manager_id")
  chat      Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  // the manager in the chat, per the bot's getChatMember: admin | member | absent | unknown; NULL = not checked yet
  memberStatus String?   @map("member_status")
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(3)

  @@id([chatId, managerId])
  @@index([managerId])
  @@map("chat_managers")
}

enum TemplateKind {
  poll
  text
  copy // a message forwarded to the bot; sent with copyMessage
}

model Template {
  id         Int            @id @default(autoincrement())
  name       String
  kind       TemplateKind
  text       String // poll question, message body, or the preview of a copy
  options    String[]
  anonymous  Boolean        @default(false)
  multiple   Boolean        @default(false)
  mentionAll Boolean        @default(false) @map("mention_all")
  // kind = poll: a quiz has its correct option (and maybe an explanation); a regular poll has neither.
  correctOptionId Int?    @map("correct_option_id")
  explanation     String?
  // kind = copy: the source message(s) in the manager's private chat with the bot; an album has several.
  sourceChatId     BigInt?  @map("source_chat_id")
  sourceMessageIds BigInt[] @default([]) @map("source_message_ids")
  mediaGroupId     String?  @map("media_group_id")
  mediaType        String?  @map("media_type")
  authorId        Int?    @map("author_id")
  author          Manager? @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now()) @map("created_at")
  items      ScheduleItem[]
  sendLogs   SendLog[]
  outbox     Outbox[]

  @@unique([sourceChatId, mediaGroupId])
  @@map("templates")
}

model Schedule {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  // NULL or a superadmin = the superadmin's schedule: every manager sees it, only a superadmin edits it
  authorId Int?        @map("author_id")
  author   Manager?    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  items ScheduleItem[]
  chats Chat[]

  @@map("schedules")
}

model ScheduleItem {
  id         Int       @id @default(autoincrement())
  scheduleId Int       @map("schedule_id")
  templateId Int       @map("template_id")
  time       String // HH:MM in TIMEZONE_NAME, or the cron of a custom item
  startDate  DateTime  @default(dbgenerated("CURRENT_DATE")) @map("start_date") @db.Date
  period     String    @default("day") // none | day | week | twoweek | month | custom (then `time` holds a 5-field cron)
  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  template   Template  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sendLogs   SendLog[]

  @@unique([scheduleId, templateId, time])
  @@map("schedule_items")
}

enum SendStatus {
  pending
  sent
  error
}

// Written by the bot. (chat, item, slot) is the idempotency key: inserting it claims the send.
model SendLog {
  id             Int           @id @default(autoincrement())
  chatId         Int           @map("chat_id")
  scheduleItemId Int?          @map("schedule_item_id")
  templateId     Int?          @map("template_id")
  slot           DateTime      @db.Timestamptz(3)
  status         SendStatus    @default(pending)
  error          String?
  messageId      BigInt?       @map("message_id")
  pollId         String?       @map("poll_id")
  outboxId       Int?          @unique @map("outbox_id") // set for manual sends; unique = one send per job
  text           String? // snapshot of the poll question / message text at send time
  options        String[]      @default([]) // snapshot of the poll options
  createdAt      DateTime      @default(now()) @map("created_at")
  chat           Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  template       Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  outbox         Outbox?       @relation(fields: [outboxId], references: [id], onDelete: SetNull)

  @@unique([chatId, scheduleItemId, slot])
  @@index([createdAt])
  @@map("send_logs")
}

// Written by the bot from poll_answer updates. poll_id is Telegram's, matched to send_logs.poll_id;
// an empty optionIds means the vote was retracted.
model PollAnswer {
  pollId    String   @map("poll_id")
  userId    BigInt   @map("user_id")
  name      String // first + last name, or username, or the id: all that rows from before first_name had
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  username  String?
  optionIds Int[]    @map("option_ids")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([pollId, userId])
  @@map("poll_answers")
}

// Written by the bot from `poll` updates, sent on every vote change of a poll the bot sent. The only source
// of results for an anonymous poll (no poll_answer updates for it); counts[i] = votes for option i.
model PollResult {
  pollId    String   @id @map("poll_id")
  anonymous Boolean
  counts    Int[]
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("poll_results")
}

// Chat members at the time a poll was sent (the panel cannot call MTProto); no rows = list unavailable.
// Journal tables (send_logs, outbox, poll_*) are trimmed daily by the bot: a year, and ~100 MB in total.
model PollMember {
  pollId    String   @map("poll_id")
  userId    BigInt   @map("user_id")
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  username  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@id([pollId, userId])
  @@map("poll_members")
}

// Manual sends queued by the panel, one row per chat; the bot claims a job by inserting its send_logs row.
model Outbox {
  id         Int       @id @default(autoincrement())
  chatId     Int       @map("chat_id")
  templateId Int?      @map("template_id")
  text       String? // custom text; wins over the template
  mentionAll Boolean   @default(false) @map("mention_all") // custom text only; a template has its own
  // a custom poll: `text` is its question, set when it has options (a template has its own)
  options    String[]  @default([])
  anonymous  Boolean   @default(false)
  multiple   Boolean   @default(false)
  sendAt     DateTime? @map("send_at") // the bot takes the job from then on; null = at once
  authorId   Int?      @map("author_id") // who queued it; only they or the superadmin cancel it
  createdAt  DateTime  @default(now()) @map("created_at")
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  author     Manager?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sendLog    SendLog?

  @@map("outbox")
}

// One row (id = 1), edited by the superadmin. bot_token and api_hash are AES-256-GCM ciphertext
// (src/lib/crypto.ts, bot/bot/settings.py). The bot restarts when any of these values change.
model Settings {
  id          Int       @id @default(1)
  botToken    String?   @map("bot_token")
  apiId       Int?      @map("api_id")
  apiHash     String?   @map("api_hash")
  // Written by the bot (getMe) at startup; not a secret.
  botUsername String?   @map("bot_username")
  // Encrypted MTProto session JSON and "Name (@username)", written by the bot after login.
  apiSession  String?   @map("api_session")
  apiAccount  String?   @map("api_account")
  // Bot status: last tick of its loop, and why it last crashed (cleared on a good start).
  botSeenAt   DateTime? @map("bot_seen_at")
  botError    String?   @map("bot_error")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

// The login wizard (one row): the panel asks a step, the bot answers with state/error.
model MtprotoLogin {
  id        Int      @id @default(1)
  step      String? // phone | qr | code | resend | password | logout, NULL once the bot took it
  input     String? // encrypted phone, code or password; cleared with step
  state     String? // what the bot waits for next: qr | code | password
  error     String?
  sent      String? // where Telegram sent the code, for the code step
  resend    Boolean  @default(false) // Telegram offers another way (auth.resendCode)
  qr        String? // tg://login link of the QR code to scan, for the qr state
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("mtproto_login")
}

// «Найти группы бота» (one row, #94): the panel queues a scan, the bot runs it through the MTProto
// account and writes how many groups with the bot it found and how many of them were new.
model ChatDiscovery {
  id        Int      @id @default(1)
  state     String   @default("queued") // queued | running | done
  found     Int?
  added     Int?
  error     String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("chat_discovery")
}
