// The panel owns the DB schema; the bot reads/writes these tables via raw SQL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  manager
}

model Manager {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  name         String   @default("")
  passwordHash String   @map("password_hash")
  role         Role     @default(manager)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  // Telegram link: the bot sets telegramUserId when the manager sends it /start link_<linkCode>.
  telegramUserId    BigInt?   @unique @map("telegram_user_id")
  linkCode          String?   @unique @map("link_code")
  linkCodeExpiresAt DateTime? @map("link_code_expires_at") @db.Timestamptz(3)
  templates         Template[]

  @@map("managers")
}

model Chat {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique @map("telegram_id")
  title      String
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  scheduleId Int?      @map("schedule_id") // a chat follows at most one schedule
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  sendLogs   SendLog[]
  outbox     Outbox[]

  @@map("chats")
}

enum TemplateKind {
  poll
  text
  copy // a message forwarded to the bot; sent with copyMessage
}

model Template {
  id         Int            @id @default(autoincrement())
  name       String
  kind       TemplateKind
  text       String // poll question, message body, or the preview of a copy
  options    String[]
  anonymous  Boolean        @default(false)
  multiple   Boolean        @default(false)
  mentionAll Boolean        @default(false) @map("mention_all")
  // kind = copy: the source message in the manager's private chat with the bot.
  sourceChatId    BigInt? @map("source_chat_id")
  sourceMessageId BigInt? @map("source_message_id")
  mediaType       String? @map("media_type")
  authorId        Int?    @map("author_id")
  author          Manager? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at")
  items      ScheduleItem[]
  sendLogs   SendLog[]
  outbox     Outbox[]

  @@map("templates")
}

model Schedule {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  items ScheduleItem[]
  chats Chat[]

  @@map("schedules")
}

model ScheduleItem {
  id         Int       @id @default(autoincrement())
  scheduleId Int       @map("schedule_id")
  templateId Int       @map("template_id")
  time       String // HH:MM in TIMEZONE_NAME
  startDate  DateTime  @default(dbgenerated("CURRENT_DATE")) @map("start_date") @db.Date
  period     String    @default("day") // none | day | week | twoweek | month
  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  template   Template  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sendLogs   SendLog[]

  @@unique([scheduleId, templateId, time])
  @@map("schedule_items")
}

enum SendStatus {
  pending
  sent
  error
}

// Written by the bot. (chat, item, slot) is the idempotency key: inserting it claims the send.
model SendLog {
  id             Int           @id @default(autoincrement())
  chatId         Int           @map("chat_id")
  scheduleItemId Int?          @map("schedule_item_id")
  templateId     Int?          @map("template_id")
  slot           DateTime      @db.Timestamptz(3)
  status         SendStatus    @default(pending)
  error          String?
  messageId      BigInt?       @map("message_id")
  pollId         String?       @map("poll_id")
  outboxId       Int?          @unique @map("outbox_id") // set for manual sends; unique = one send per job
  text           String? // snapshot of the poll question / message text at send time
  options        String[]      @default([]) // snapshot of the poll options
  createdAt      DateTime      @default(now()) @map("created_at")
  chat           Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  template       Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  outbox         Outbox?       @relation(fields: [outboxId], references: [id], onDelete: SetNull)

  @@unique([chatId, scheduleItemId, slot])
  @@index([createdAt])
  @@map("send_logs")
}

// Written by the bot from poll_answer updates. poll_id is Telegram's, matched to send_logs.poll_id;
// an empty optionIds means the vote was retracted.
model PollAnswer {
  pollId    String   @map("poll_id")
  userId    BigInt   @map("user_id")
  name      String
  optionIds Int[]    @map("option_ids")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([pollId, userId])
  @@map("poll_answers")
}

// Chat members at the time a poll was sent (the panel cannot call MTProto); no rows = list unavailable.
// The bot deletes poll_members and poll_answers rows older than a year.
model PollMember {
  pollId    String   @map("poll_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([pollId, userId])
  @@map("poll_members")
}

// Manual sends queued by the panel, one row per chat; the bot claims a job by inserting its send_logs row.
model Outbox {
  id         Int       @id @default(autoincrement())
  chatId     Int       @map("chat_id")
  templateId Int?      @map("template_id")
  text       String? // custom text; wins over the template
  createdAt  DateTime  @default(now()) @map("created_at")
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sendLog    SendLog?

  @@map("outbox")
}

// One row (id = 1), edited by the superadmin. bot_token and api_hash are AES-256-GCM ciphertext
// (src/lib/crypto.ts, bot/bot/settings.py). The bot restarts when any of these values change.
model Settings {
  id          Int       @id @default(1)
  botToken    String?   @map("bot_token")
  apiId       Int?      @map("api_id")
  apiHash     String?   @map("api_hash")
  // Written by the bot (getMe) at startup; not a secret.
  botUsername String?   @map("bot_username")
  // Encrypted MTProto session JSON and "Name (@username)", written by the bot after login.
  apiSession  String?   @map("api_session")
  apiAccount  String?   @map("api_account")
  // Bot status: last tick of its loop, and why it last crashed (cleared on a good start).
  botSeenAt   DateTime? @map("bot_seen_at")
  botError    String?   @map("bot_error")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

// The login wizard (one row): the panel asks a step, the bot answers with state/error.
model MtprotoLogin {
  id        Int      @id @default(1)
  step      String? // phone | qr | code | resend | password | logout, NULL once the bot took it
  input     String? // encrypted phone, code or password; cleared with step
  state     String? // what the bot waits for next: qr | code | password
  error     String?
  sent      String? // where Telegram sent the code, for the code step
  resend    Boolean  @default(false) // Telegram offers another way (auth.resendCode)
  qr        String? // tg://login link of the QR code to scan, for the qr state
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("mtproto_login")
}
