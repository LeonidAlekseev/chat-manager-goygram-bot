# Replaces the image's template: its CONTAINERS=1 would also allow GET /containers/{id}/json (env with secrets)
# and /archive, /export (container files). The panel needs only the container list and logs.
global
    log stdout format raw daemon info
    pidfile /run/haproxy.pid

defaults
    mode http
    log global
    option httplog
    option dontlognull
    timeout http-request 10s
    timeout connect 10s
    timeout client 30s
    timeout server 30s

backend dockerbackend
    server dockersocket /var/run/docker.sock

frontend dockerfrontend
    bind ${BIND_CONFIG}
    http-request deny unless METH_GET
    http-request allow if { path,url_dec -m reg ^(/v[0-9.]+)?/containers/json$ }
    http-request allow if { path,url_dec -m reg ^(/v[0-9.]+)?/containers/[a-zA-Z0-9_.-]+/logs$ }
    http-request deny
    default_backend dockerbackend
