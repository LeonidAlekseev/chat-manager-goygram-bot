{
	# HTTP/3 off: Safari hangs when QUIC/UDP degrades instead of falling back to TCP (#54).
	servers {
		protocols h1 h2
	}
}

# HTTPS certificates are issued automatically for PANEL_DOMAIN.
# reverse_proxy overwrites an untrusted client X-Forwarded-For with the client IP,
# which is what web/src/lib/loginLimit.ts relies on.
{$PANEL_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 10MB
	}
	reverse_proxy web:3000
}
